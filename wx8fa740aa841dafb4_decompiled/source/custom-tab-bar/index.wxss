.sp-tabbar {
  background-color: #fff;
  border-top: 1rpx solid #e5e5e5;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  overflow: hidden;
  padding: 20rpx 36rpx 0rpx;
}
.sp-tabbar .cart-count1 {
  border-radius: 44rpx;
  min-width: 36rpx;
  padding: 0 8rpx;
}
.sp-tabbar .cart-count,
.sp-tabbar .cart-count1 {
  align-items: center;
  background-color: #d4003b;
  box-sizing: border-box;
  color: #fff;
  display: flex;
  font-family: PingFang SC;
  font-size: 20rpx;
  font-weight: 500;
  height: 28rpx;
  justify-content: center;
}
.sp-tabbar .cart-count {
  border-radius: 50%;
  padding: 17rpx;
  width: 0rpx;
}
.sp-tabbar__item {
  align-items: center;
  display: flex;
  flex-direction: column;
  height: 86rpx;
  justify-content: space-between;
  width: 96rpx;
}
.sp-tabbar__item-cover-image {
  border-radius: 100%;
  height: 86rpx;
  overflow: hidden;
  width: 86rpx;
}
.sp-tabbar__item-text {
  font-family: PingFang SC;
  font-size: 20rpx;
  font-style: normal;
  font-weight: 500;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  text-transform: none;
}
.sp-tabbar__item-badge {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  z-index: 9;
}
.sp-tabbar__item-badge1 {
  position: absolute;
  right: -24rpx;
  top: -10rpx;
  z-index: 9;
}
.sp-tabbar__item-image-wrapper {
  position: relative;
}
.sp-tabbar__item-image {
  height: 56rpx;
  width: 56rpx;
}
.sp-tabbar image {
  height: 100%;
  width: 100%;
}
