.comp-first-category {
  align-items: baseline;
  display: flex;
  height: 150rpx;
  justify-content: space-between;
  position: relative;
  width: 100%;
}
.comp-first-category-content {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  padding: 0 12rpx;
  white-space: nowrap;
}
.comp-first-category-content .category-item {
  margin: 0 12rpx;
}
.comp-first-category-scrollX {
  width: calc(100% - 50rpx);
}
.comp-first-category .category-item {
  align-items: center;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  width: 18%;
}
.comp-first-category .category-item .sp-image {
  border-radius: 50%;
}
.comp-first-category .category-item .category-image {
  background-color: #fff;
  border: 4rpx solid #fff;
  border-radius: 50%;
  padding: 3rpx;
}
.comp-first-category .category-item .category-name {
  border-radius: 26rpx;
  color: #333;
  font-size: 22rpx;
  margin-top: 15rpx;
  max-width: 100rpx !important;
  min-width: 90rpx !important;
  overflow: hidden;
  padding: 4rpx 10rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.comp-first-category .category-item.active .category-image {
  border-color: var(--color-primary);
}
.comp-first-category .category-item.active .category-name {
  background-color: var(--color-primary);
  color: #fff;
  min-width: 0rpx;
}
.comp-first-category-filter {
  border-radius: 5rpx 0rpx 0rpx 5rpx;
  box-shadow: -3rpx 0rpx 6rpx -5rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 166rpx;
  justify-content: center;
  padding: 0rpx 13rpx;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  width: 50rpx;
}
.comp-first-category-filter text {
  color: #444;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}
.comp-first-category-float {
  background: rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  display: none;
  height: 95vh;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 888;
}
.comp-first-category .sp-select-box {
  align-items: baseline;
  background: #f5f5f5;
  box-sizing: border-box;
  display: flex;
  flex-flow: wrap;
  padding-top: 20rpx;
  position: relative;
  width: 100%;
}
.comp-first-category .sp-select-box .category-full {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  max-height: 700rpx;
  min-height: 500rpx;
  padding-bottom: 24rpx;
  width: 100vw;
}
.comp-first-category .sp-select-box .category-full-container {
  padding: 0 12rpx;
}
.comp-first-category .sp-select-box .category-full-container .category-item {
  margin-bottom: 24rpx;
}
.comp-first-category .sp-select-box .category-full::-webkit-scrollbar {
  display: none;
  width: 0rpx !important;
}
.comp-first-category .sp-select-box .category-full-container {
  display: flex;
  flex-wrap: wrap;
}
.comp-first-category .isshow {
  display: block;
}
.comp-first-category .rotate {
  transform: rotate(-180deg);
}
.comp-first-category .icon-arrowDown {
  font-size: 28rpx;
}
.comp-first-category .icon-close {
  color: #222;
  font-size: 36rpx;
  position: absolute;
  right: 15rpx;
  top: -10rpx;
}
.comp-second-category {
  box-sizing: border-box;
  display: flex;
  justify-content: flex-start;
}
.comp-second-category .category-item {
  display: flex;
  height: 78rpx;
  justify-content: center;
  line-height: 78rpx;
  position: relative;
}
.comp-second-category .category-item.active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
}
.comp-second-category .category-item.active:before {
  background: var(--color-primary);
  content: "";
  height: 30rpx;
  left: 0;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
}
.comp-second-category .category-item.active .category-name {
  color: var(--color-primary);
}
.comp-second-category .category-item .category-name {
  color: #666;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 160rpx;
}
.comp-second-category-scroll::-webkit-scrollbar {
  display: none;
  width: 0rpx !important;
}
.comp-third-category {
  align-items: baseline;
  box-sizing: border-box;
  display: flex;
  height: 80rpx;
  justify-content: space-between;
  padding-right: 50rpx;
  position: relative;
  white-space: nowrap;
  width: 100%;
}
.comp-third-category-filter {
  align-items: center;
  background: #fff;
  border-radius: 5rpx 0rpx 0rpx 5rpx;
  bottom: 0rpx;
  box-shadow: -3rpx 0rpx 6rpx -5rpx rgba(0, 0, 0, 0.2);
  display: flex;
  height: 80rpx;
  justify-content: center;
  position: absolute;
  right: 0rpx;
  width: -moz-fit-content;
  width: fit-content;
}
.comp-third-category .icon-arrowDown {
  box-sizing: border-box;
  font-size: 20rpx;
  padding: 0 18rpx;
  width: 50rpx;
}
.comp-third-category-scroll .scroll-container {
  align-items: center;
  display: flex;
  height: 80rpx;
  padding: 0 8rpx;
}
.comp-third-category-scroll .scroll-container .category-item {
  background: #fff;
  height: 40rpx;
  line-height: 40rpx;
  margin: 0 8rpx;
}
.comp-third-category-scroll
  .scroll-container
  .category-item.active
  .category-name {
  background-color: rgba(var(--color-rgb), 0.2);
  color: var(--color-primary);
  font-weight: 600;
}
.comp-third-category-scroll .scroll-container .category-name {
  background: #f3f3f3;
  border-radius: 20rpx;
  color: #666;
  font-size: 30rpx;
  padding: 0 20rpx;
}
.comp-third-category-float {
  background: rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
  display: none;
  height: 78vh;
  left: 0;
  position: absolute;
  top: 100%;
  width: 100vw;
  z-index: 888;
}
.comp-third-category .sp-select-box {
  background: #fff;
  display: flex;
  white-space: normal;
  width: calc(100vw - 128rpx);
}
.comp-third-category .sp-select-box .sp-select {
  padding: 16rpx 0 0 16rpx;
  width: 100%;
}
.comp-third-category .sp-select-box .select-item {
  border-radius: 20rpx;
  font-size: 30rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 0 20rpx;
}
.comp-third-category .isshow {
  display: block;
}
.comp-third-category .rotate {
  transform: rotate(-180deg);
}
.comp-goods-item {
  display: flex;
}
.comp-goods-item .goods-item__hd .sp-image {
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.comp-goods-item .goods-item__hd .image-wrap {
  height: 160rpx;
  position: relative;
  width: 160rpx;
}
.comp-goods-item .goods-item__hd .shouqin-icon {
  border-radius: 8rpx;
  bottom: 0;
  height: 100%;
  left: -18rpx;
  overflow: hidden;
  padding: 20rpx;
  position: absolute !important;
  right: 0;
  top: -18rpx;
  width: 100%;
}
.comp-goods-item .goods-item__hd .shuiyin {
  align-items: center;
  border-radius: 15rpx;
  bottom: 0;
  color: #fff;
  display: flex;
  font-size: 24rpx;
  justify-content: center;
  left: 0;
  padding: 8rpx 20rpx;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 99;
}
.comp-goods-item .goods-item__hd .shuiyin-show {
  background: rgba(var(--color-rgb), 0.6);
}
.comp-goods-item .goods-item__hd .shuiyin-nostore {
  background: rgba(0, 0, 0, 0.5);
}
.comp-goods-item .goods-item__bd {
  border-radius: 0;
  flex: 1;
  margin-left: 16rpx;
}
.comp-goods-item .goods-item__bd .goods-title {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  color: #222;
  display: -webkit-box;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 312rpx;
  word-break: break-all;
}
.comp-goods-item .goods-item__bd .goods-title .prescription-drug {
  border: 1px solid var(--color-primary);
  border-radius: 4rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 34rpx;
  margin-right: 8rpx;
  padding: 0 4rpx;
}
.comp-goods-item .goods-item__bd .goods-desc {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  color: #666;
  display: -webkit-box;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.comp-goods-item .goods-item__bd .gd-price {
  align-items: center;
  display: flex;
  width: 100%;
}
.comp-goods-item .goods-item__bd .gd-price .sp-price {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
}
.comp-goods-item .goods-item__bd .gd-price .sp-price__symbol {
  margin-right: 10rpx;
}
.comp-goods-item .goods-item__bd .gd-price .unit-price {
  color: #bbb;
  font-family: PingFangSC, PingFang SC;
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 20rpx;
  text-decoration: line-through;
}
.comp-goods-item .goods-item__bd .gd-price .unit {
  color: #bbb;
  font-size: 24rpx;
}
.comp-goods-item .goods-item__bd .promotion-tag-direct {
  border: 1px solid #f4811f;
  border-radius: 8rpx;
  color: #f4811f;
  font-size: 22rpx;
  height: 32rpx;
  line-height: 32rpx;
  margin-right: 10rpx;
  padding: 0 11rpx;
}
.comp-goods-item .goods-item__bd .mk-price .sp-price {
  color: #888;
  font-size: 24rpx;
  font-weight: 400;
  text-decoration: line-through;
}
.comp-goods-item .goods-item__bd .promotions {
  display: flex;
  flex-wrap: wrap;
  height: 32rpx;
  margin-top: 22rpx;
}
.comp-goods-item .goods-item__bd .promotions .promotion-tag {
  border: 1px solid var(--color-primary);
  border-radius: 8rpx;
  color: var(--color-primary);
  font-size: 28rpx;
  height: 32rpx;
  line-height: 32rpx;
  margin-right: 10rpx;
  padding: 0 11rpx;
}
.comp-goods-item .goods-item__bd .bd-block {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}
.comp-goods-item .goods-item__bd .bd-block .goods-price {
  width: 100%;
}
.comp-goods-item .goods-item__bd .bd-block-rg .iconfont {
  color: #666;
  font-size: 40rpx;
}
.comp-goods-item .goods-item__bd .bd-block-rg .icon-shoucanghover-01 {
  color: var(--color-primary);
}
.comp-goods-item .icon-gouwuche2 {
  color: var(--color-primary);
  font-size: 40rpx;
}
.comp-goods-item .goods__store {
  color: #818181;
  font-size: 20rpx;
  letter-spacing: 0;
  padding-top: 16rpx;
}
.comp-goods-item .goods__store-entry {
  color: #333;
}
.comp-goods-item .goods-info-box {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 13rpx;
}
.comp-goods-item .goods-info-box .goods-store {
  color: #999;
  font-size: 22rpx;
}
.comp-goods-item .goods-info-box .goods-cart .icon-gouwuche {
  background: var(--color-primary);
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  padding: 5rpx;
}
.page-category-index-old {
  box-sizing: border-box;
  height: 100%;
  padding-bottom: 110rpx;
  width: 100%;
}
.page-category-index-old .sp-category-search .search-wrap-input {
  border-color: rgba(var(--color-rgb), 0.5);
  border-style: solid;
  border-width: 1rpx;
}
.page-category-index-old .sp-category-search .search-wrap-input .at-icon {
  color: #999;
}
.page-category-index-old .comp-first-category .sp-select-box {
  border-radius: 0 0 20rpx 20rpx;
}
.page-category-index-old .sp-price__decimal,
.page-category-index-old .sp-price__int,
.page-category-index-old .sp-price__symbol {
  color: var(--color-primary) !important;
}
.page-category-index-old .category-search {
  align-items: center;
  background-color: #f5f5f5;
  display: flex;
}
.page-category-index-old .category-search .type {
  background: #fcd700;
  border: 1px solid transparent;
  border-radius: 30rpx;
  box-sizing: border-box;
  height: 60rpx;
  line-height: 58rpx;
  text-align: center;
  width: 108rpx;
}
.page-category-index-old .category-search .type .text {
  color: #000;
  font-size: 24rpx;
  font-weight: 400;
}
.page-category-index-old .category-search .disable {
  background-color: #fff;
  border-color: #999;
}
.page-category-index-old .category-search .disable .text {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
}
.page-category-index-old .sp-category-search {
  flex: 1;
  padding: 19rpx 24rpx;
  width: auto;
}
.page-category-index-old .sp-page-footer {
  height: -moz-fit-content;
  height: fit-content;
}
.page-category-index-old .container-hd {
  box-sizing: border-box;
  height: 242rpx;
  left: 0;
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 99;
}
.page-category-index-old .container-bd {
  background: #fff;
  display: flex;
  height: 76%;
  left: 0;
  position: fixed;
  top: 266rpx;
  width: 100%;
}
.page-category-index-old .container-bd .left-container {
  background: #f5f5f5;
  box-sizing: border-box;
  height: 100%;
  overflow-y: auto;
  padding-bottom: 90rpx;
  text-align: center;
  width: 200rpx;
}
.page-category-index-old .container-bd .left-container::-webkit-scrollbar {
  display: none;
  width: 0rpx !important;
}
.page-category-index-old .container-bd .right-container {
  flex: 1;
  flex-shrink: 0;
  padding-bottom: 60rpx;
  padding-top: 80rpx;
  position: relative;
}
.page-category-index-old .container-bd .right-container-fixed {
  background: #fff;
  height: 90rpx;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
  z-index: 999;
}
.page-category-index-old
  .container-bd
  .right-container-fixed
  .filter-bar__item-text,
.page-category-index-old
  .container-bd
  .right-container-fixed
  .goods-list__tabs {
  font-size: 22rpx;
  height: 60rpx;
  line-height: 60rpx;
}
.page-category-index-old .goods-list-container {
  height: 100%;
}
.page-category-index-old .goods-list-container .sp-scrollview-body {
  padding: 24rpx 20rpx;
}
.page-category-index-old
  .goods-list-container
  .goods-item-wrap:not(:last-child) {
  margin-bottom: 24rpx;
}
.page-category-index-old .at-divider__content {
  background-color: #fff;
}
.page-category.category-flat-layout {
  display: flex;
  height: 100%;
}
.page-category.category-flat-layout .category-flat-layout__main-category {
  background-color: #fff;
  border-right: 1rpx solid #ebebeb;
  height: 100%;
  width: 168rpx;
}
.page-category.category-flat-layout .category-flat-layout__category-item {
  align-items: center;
  color: #666;
  display: flex;
  font-size: 26rpx;
  height: 108rpx;
  justify-content: center;
  overflow: hidden;
}
.page-category.category-flat-layout
  .category-flat-layout__category-item--active {
  background-color: #ebebeb;
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 500;
}
.page-category.category-flat-layout .category-flat-layout__category-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.page-category.category-flat-layout .category-flat-layout__category-content {
  background-color: #fff;
  box-sizing: border-box;
  flex: 1;
  height: 100%;
  overflow: hidden;
}
.page-category.category-flat-layout
  .category-flat-layout__category-content
  .category-item__list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: -24rpx;
  padding: 0 36rpx;
}
.page-category.category-flat-layout
  .category-flat-layout__category-content
  .category-item__list__text {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.page-category.category-flat-layout
  .category-flat-layout__category-content
  .category-item {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  margin-right: 29rpx;
  width: 150rpx;
}
.page-category.category-flat-layout
  .category-flat-layout__category-content
  .category-item:nth-child(3n) {
  margin-right: 0;
}
