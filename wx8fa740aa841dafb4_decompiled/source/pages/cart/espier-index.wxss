.sp-delivery-modal {
  align-items: center;
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}
.sp-delivery-modal__mask {
  background-color: rgba(0, 0, 0, 0.6);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.sp-delivery-modal__container {
  background-color: #fff;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  overflow: hidden;
  position: relative;
  width: 590rpx;
}
.sp-delivery-modal__container--cart {
  padding: 60rpx 48rpx;
}
.sp-delivery-modal__desc {
  color: #666;
  font-size: 30rpx;
  line-height: 1.5;
  text-align: center;
}
.sp-delivery-modal__header {
  align-items: center;
  display: flex;
  justify-content: center;
  padding: 0 24rpx 16rpx;
  position: relative;
}
.sp-delivery-modal__icon {
  margin-right: 8rpx;
}
.sp-delivery-modal__title {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  color: #1a1a1a;
  display: -webkit-box;
  font-size: 34rpx;
  font-style: normal;
  font-weight: 500;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  text-transform: none;
  word-break: break-all;
}
.sp-delivery-modal__close {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  justify-content: flex-end;
  padding-right: 24rpx;
  padding-top: 24rpx;
  width: 100%;
}
.sp-delivery-modal__goods-scroll {
  box-sizing: border-box;
  max-height: 608rpx;
  overflow-y: auto;
  padding-top: 48rpx;
}
.sp-delivery-modal__goods-panel {
  background: #f8f8f8;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 12rpx;
}
.sp-delivery-modal__footer {
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  padding-top: 48rpx;
  width: 100%;
}
.sp-delivery-modal__btn {
  border-radius: 12rpx;
  box-sizing: border-box;
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  white-space: nowrap;
}
.sp-delivery-modal__btn--back {
  background: #fff;
  border: 1px solid #ebebeb;
  color: #666;
}
.sp-delivery-modal__btn--express {
  background-color: var(--color-primary);
  color: #fff;
}
.sp-cart-cross-town-ziti-modal {
