.page-cart__region-footer {
  align-items: center;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  height: 120rpx;
  justify-content: space-between;
  padding: 0 24rpx 0rpx 36rpx;
  position: sticky;
  z-index: 99;
}
.page-cart__isregion-footer {
  border: none;
}
.page-cart__region-footer-info {
  align-items: center;
  display: flex;
  flex: 1;
  justify-content: space-between;
  min-width: 0;
}
.page-cart__region-footer-label {
  color: #bfbfbf;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
  margin-right: 16rpx;
}
.page-cart__region-footer-select {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.page-cart__region-footer-select-text {
  color: #bfbfbf;
  font-size: 24rpx;
  margin-left: 4rpx;
}
.page-cart__region-footer-right {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.page-cart__region-footer-price {
  align-items: baseline;
  display: flex;
}
.page-cart__region-footer-price-label {
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 400;
  margin-right: 6rpx;
}
.page-cart__region-footer-discount {
  align-items: center;
  display: flex;
}
.page-cart__region-footer-discount-text {
  color: #999;
  font-size: 20rpx;
  margin-right: 4rpx;
}
.page-cart__region-footer-btn {
  align-items: center;
  background: var(--color-primary);
  border-radius: 16rpx;
  color: #fff;
  display: flex;
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 500;
  height: 84rpx;
  justify-content: center;
  line-height: 84rpx;
  margin-left: 20rpx;
  min-width: 188rpx;
  transition: all 0.3s ease;
}
.page-cart__region-footer-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
.page-cart__region-footer-btn--disabled {
  background: #ccc;
  box-shadow: none;
}
.page-cart__region-footer-btn--disabled:active {
  opacity: 1;
  transform: none;
}
.page-cart__footer-tip {
  align-items: center;
  display: flex;
  flex: 1;
  justify-content: center;
}
.page-cart__footer-tip-text {
  color: #999;
  font-size: 24rpx;
}
.page-cart__scroll-top {
  align-items: flex-end;
  bottom: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  position: fixed;
  right: 24rpx;
  transition: opacity 0.3s ease-in-out;
  z-index: 300;
}
.page-cart__scroll-top .sp-float-menu-item {
  background: #fff;
  border: 2rpx solid #ebebeb;
  border-radius: 42rpx;
  box-shadow: 0rpx 8rpx 24rpx 0rpx rgba(0, 0, 0, 0.08);
  height: 84rpx;
  width: 84rpx;
}
.page-cart__scroll-top .icon-zhiding {
  color: #1a1a1a;
  font-size: 34rpx;
}
.page-cart__scroll-top--show {
  opacity: 1;
  pointer-events: auto;
}
