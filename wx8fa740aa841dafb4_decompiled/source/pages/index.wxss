.page-index {
  height: 100vh;
}
.page-index,
.page-index .sp-page__body {
  overflow: hidden;
}
.page-index__navigation {
  align-items: center;
  display: flex;
  height: 64rpx;
  min-width: 0;
  position: relative;
  width: 100%;
}
.page-index__navigation .sp-area-select {
  flex: 1;
  margin-right: 0;
  min-width: 0;
  z-index: 1;
}
.page-index__navigation .sp-search-one--collapsible {
  margin-right: 0;
  position: absolute;
  right: 32rpx;
  top: 0;
  z-index: 4;
}
.page-index .home-body {
  -webkit-overflow-scrolling: auto;
  height: 100%;
  overflow: hidden;
}
.lazy-widget-mount {
  background: linear-gradient(180deg, #fafafa, #f5f5f5);
  width: 100%;
}
