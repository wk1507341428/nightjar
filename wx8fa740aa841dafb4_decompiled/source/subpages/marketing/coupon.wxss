@import "/subpages/marketing/sub-vendors.wxss";
.page-marketing-coupon {
  box-sizing: border-box;
}
.page-marketing-coupon .float-container {
  bottom: 180rpx;
}
.page-marketing-coupon .sp-page__body {
  display: flex;
  flex-direction: column;
}
.page-marketing-coupon .sticky-wrap .sp-area-select {
  background-color: #fff;
  box-sizing: border-box;
  height: 92rpx;
  justify-content: space-between;
  padding: 0 24rpx;
  width: 100%;
}
.page-marketing-coupon .sticky-wrap .sp-area-select .items-center {
  justify-content: space-between;
  width: 100%;
}
.page-marketing-coupon .sticky-wrap .coupon-item-btns {
  align-items: center;
  background-color: #fff;
  display: flex;
  font-size: 26rpx;
  justify-content: space-around;
  padding-bottom: 18rpx;
  padding-top: 12rpx;
  width: 100%;
}
.page-marketing-coupon .sticky-wrap .coupon-item-btns .btn {
  align-items: center;
  display: flex;
  justify-content: center;
  width: 120rpx;
}
.page-marketing-coupon .sticky-wrap .coupon-item-btns .btn-active {
  background: rgba(212, 0, 59, 0.1);
  border: 1rpx solid rgba(212, 0, 59, 0.15);
  border-radius: 24rpx;
  color: #d4003b;
  font-weight: 500;
  padding: 10rpx 0rpx;
  width: 126rpx;
}
.page-marketing-coupon .sticky-wrap .coupon-item-btns .btn-primary {
  background: #f8f8f8;
  border: 1rpx solid #ebebeb;
  border-radius: 24rpx;
  color: #999;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 400;
  padding: 10rpx 0rpx;
  width: 126rpx;
}
.page-marketing-coupon .empty-wrap {
  padding-top: 126rpx;
  text-align: center;
}
.page-marketing-coupon .empty-wrap .iconfont {
  color: #d6d6d6;
  font-size: 64rpx;
  line-height: 64rpx;
}
.page-marketing-coupon .empty-wrap .empty-text1 {
  color: #404040;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 33rpx;
  padding: 24rpx 0 6rpx;
}
.page-marketing-coupon .empty-wrap .empty-text2 {
  color: #999;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 28rpx;
}
.page-marketing-coupon .coupon-btn {
  background: #000;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  text-align: center;
}
.page-marketing-coupon .coupon-btn.btn-1,
.page-marketing-coupon .coupon-btn.btn-2 {
  background: #bfbfbf;
}
.page-marketing-coupon .list-scroll {
  box-sizing: border-box;
  flex: 1;
  height: 100%;
  padding: 0 20rpx 176rpx;
}
.page-marketing-coupon .list-scroll .coupon-item-wrap {
  margin-top: 20rpx;
}
.page-marketing-coupon .list-scroll .coupon-item-wrap:last-child {
  margin-bottom: 20rpx;
}
.page-marketing-coupon .btn-wrap {
  box-sizing: border-box;
  display: flex;
  font-size: 28rpx;
  font-weight: 400;
  gap: 18rpx;
  line-height: 33rpx;
  padding: 20rpx 36rpx 80rpx;
}
.page-marketing-coupon .btn-wrap .footer-btn {
  align-items: center;
  border: 2rpx solid #ebebeb;
  border-radius: 12rpx;
  display: flex;
  flex: 1;
}
.page-marketing-coupon .btn-wrap .footer-btn:last-child {
  background: rgba(203, 152, 0, 0.1);
  border-color: rgba(203, 152, 0, 0.15);
  color: #cb9800;
}
.page-marketing-coupon .btn-wrap .footer-btn:last-child .sp-image {
  margin-left: 8rpx;
}
.page-marketing-coupon .btn-wrap .footer-btn .btn-text-wrap {
  align-items: center;
  display: flex;
  gap: 6rpx;
  justify-content: center;
}
.page-marketing-coupon .btn-wrap .footer-btn .iconfont {
  font-size: 32rpx;
}
