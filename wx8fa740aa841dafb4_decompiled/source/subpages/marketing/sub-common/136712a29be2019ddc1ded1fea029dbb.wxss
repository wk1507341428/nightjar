.sp-logistics {
  align-items: center;
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1000;
}
.sp-logistics__overlay {
  background-color: rgba(0, 0, 0, 0.6);
  bottom: 0;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
}
.sp-logistics__container {
  background-color: #fff;
  border-radius: 16rpx 16rpx 0 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  position: relative;
  position: absolute;
  right: 0;
  width: 100%;
  z-index: 1001;
}
.sp-logistics__header {
  align-items: center;
  border-bottom: 1px solid #f5f5f5;
  display: flex;
  height: 100rpx;
  justify-content: center;
  position: relative;
}
.sp-logistics__title {
  color: #333;
  font-size: 32rpx;
  font-weight: 500;
}
.sp-logistics__close {
  align-items: center;
  display: flex;
  height: 40rpx;
  justify-content: center;
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
}
.sp-logistics--closed {
  opacity: 0;
  transform: translateY(100%);
  transition: all 0s ease-in-out 0.3s;
}
.sp-logistics--closed .sp-logistics__overlay {
  opacity: 0;
  transition: all 0.3s ease-in-out;
}
.sp-logistics--closed .sp-logistics__container {
  opacity: 0;
  transform: translateY(100%);
  transition: all 0.3s ease-in-out;
}
.sp-logistics--opened {
  opacity: 1;
  transform: translateY(0);
}
.sp-logistics--opened .sp-logistics__overlay {
  opacity: 1;
  transition: all 0.3s ease-in-out;
}
.sp-logistics--opened .sp-logistics__container {
  opacity: 1;
  transform: translateY(0);
  transition: all 0.3s ease-in-out;
}
.sp-logistics__content {
  padding: 24rpx 36rpx 376rpx;
}
.sp-logistics .sp-cell {
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
  height: 112rpx;
  margin-bottom: 24rpx;
  padding: 36rpx 24rpx;
}
.sp-logistics__input-wrapper {
  align-items: center;
  display: flex;
  justify-content: flex-end;
}
.sp-logistics__input {
  background-color: initial !important;
  color: #333;
  flex: 1;
  font-size: 28rpx;
  margin: 0 !important;
  padding: 0 !important;
}
.sp-logistics__input .at-input__input {
  text-align: right !important;
}
.sp-logistics__placeholder {
  color: #bfbfbf;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 33rpx;
}
.sp-logistics__footer {
  background: linear-gradient(180deg, hsla(0, 0%, 100%, 0), #fff 17%);
  border-radius: 0rpx;
  box-sizing: border-box;
  padding: 36rpx 36rpx 0;
}
.sp-logistics__submit-btn {
  background: #1a1a1a !important;
  border: none !important;
  border-radius: 12rpx !important;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 500 !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
}
