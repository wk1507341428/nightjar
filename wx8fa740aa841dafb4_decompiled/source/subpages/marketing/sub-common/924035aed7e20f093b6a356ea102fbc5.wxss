.sp-search-input {
  align-items: center;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  height: 70rpx;
  padding: 10rpx 24rpx;
}
.sp-search-input .area {
  align-items: center;
  display: flex;
  margin-right: 26rpx;
}
.sp-search-input .area-val {
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-search-input .area-icon {
  margin-left: 10rpx;
}
.sp-search-input .area .area-clear-icon {
  font-size: 18rpx;
}
.sp-search-input .search-input {
  align-items: center;
  background: #f5f5f5;
  border-radius: 30rpx;
  box-sizing: border-box;
  display: flex;
  padding: 10rpx 20rpx;
  width: 100%;
}
.sp-search-input .search-input .icon-sousuo-01 {
  color: #666f83;
  font-size: 32rpx;
}
.sp-search-input .search-input .at-input {
  background: transparent;
  flex: 1;
  margin: 0 20rpx;
  padding: 0;
}
.sp-search-input .search-input .at-input:after {
  display: none;
}
.sp-search-input .search-input .at-input__input {
  color: #666;
  font-size: 26rpx;
}
.sp-search-input .search-input .search-condition {
  align-items: center;
  border-right: 1rpx solid #e2e4ea;
  display: flex;
  flex-wrap: nowrap;
  padding-right: 17rpx;
  white-space: nowrap;
}
.sp-search-input .search-input .search-condition-icon {
  margin-left: 10rpx;
}
