.sp-goods-reduction-detail-modal .sp-float-layout-bd {
  padding: 0 24rpx;
}
.sp-goods-reduction-detail-modal__content {
  padding: 0rpx 0 48rpx;
}
.sp-goods-reduction-detail-modal__summary {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  padding: 18rpx 24rpx;
}
.sp-goods-reduction-detail-modal__summary-title {
  color: #d4003b;
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.3;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
}
.sp-goods-reduction-detail-modal__summary-amount {
  color: #d4003b;
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.3;
}
.sp-goods-reduction-detail-modal__region-card {
  background: #f8f8f8;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  padding: 24rpx;
}
.sp-goods-reduction-detail-modal__region-card:last-child {
  margin-bottom: 0;
}
.sp-goods-reduction-detail-modal__region-name {
  color: #404040;
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.sp-goods-reduction-detail-modal__product-scroll {
  white-space: nowrap;
  width: 100%;
}
.sp-goods-reduction-detail-modal__product-grid {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding-right: 4rpx;
}
.sp-goods-reduction-detail-modal__product {
  align-items: center;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 112rpx;
}
.sp-goods-reduction-detail-modal__product-imgwrap {
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  width: 100%;
}
.sp-goods-reduction-detail-modal__product-img {
  border-radius: 8rpx;
  display: block;
  width: 100%;
}
.sp-goods-reduction-detail-modal__product-badge {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 0 8rpx 0 8rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 20rpx;
  line-height: 1.4;
  min-width: 44rpx;
  padding: 2rpx 8rpx;
  position: absolute;
  right: 0;
  text-align: center;
  top: 0;
  z-index: 99;
}
.sp-goods-reduction-detail-modal__product-discount {
  color: #d4003b;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
  width: 100%;
  word-break: break-all;
}
