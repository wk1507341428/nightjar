.sp-tag-bar {
  align-items: center;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  height: 90rpx;
  justify-content: space-between;
  padding: 12rpx 18rpx;
}
.sp-tag-bar .tag-container .tag-container-flex {
  align-items: center;
  display: inline-flex;
  flex-shrink: 0;
  gap: 36rpx;
  justify-content: flex-start;
  width: -moz-fit-content;
  width: fit-content;
}
.sp-tag-bar .tag-container .tag-container-flex .active {
  color: #1a1a1a;
  font-family: PingFang SC;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: -4rpx;
}
.sp-tag-bar .tag-item {
  color: #666;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 400;
  min-width: -moz-fit-content;
  min-width: fit-content;
}
.sp-tag-bar .tag-item.active {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 500;
}
