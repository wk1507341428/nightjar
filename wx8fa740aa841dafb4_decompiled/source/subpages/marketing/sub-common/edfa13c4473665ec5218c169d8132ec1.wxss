.brand-filter__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}
.brand-filter__item {
  align-items: center;
  background-color: #fff;
  border-bottom: 1px solid #ebebeb;
  box-sizing: border-box;
  color: #333;
  display: flex;
  font-size: 26rpx;
  height: 60rpx;
  justify-content: flex-start;
  padding: 12rpx 0rpx;
}
.brand-filter__item:nth-child(2n + 1) {
  border-right: 1px solid #ebebeb;
  padding-left: 36rpx;
}
.brand-filter__item:nth-child(2n) {
  padding-left: 18rpx;
}
.brand-filter__item--selected {
  background: #fff;
  border: 2rpx solid #1a1a1a !important;
  color: #1a1a1a;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 500;
}
.brand-filter__item--more {
  border: none !important;
  color: #576b95;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 30rpx;
}
.brand-filter__item-icon {
  height: 24rpx;
  width: 24rpx;
}
