.sp-order-coupon-detail-modal .sp-float-layout-bd {
  padding: 0 24rpx;
}
.sp-order-coupon-detail-modal__wrap {
  padding-bottom: 24rpx;
  position: relative;
}
.sp-order-coupon-detail-modal__scroll {
  max-height: 764rpx;
}
.sp-order-coupon-detail-modal__list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 10rpx 0 48rpx;
}
.sp-order-coupon-detail-modal__fade {
  background: linear-gradient(180deg, hsla(0, 0%, 100%, 0), #fff 62%);
  bottom: 0;
  height: 100rpx;
  left: 0;
  pointer-events: none;
  position: absolute;
  right: 0;
}
.sp-order-coupon-detail-modal__card {
  align-items: stretch;
  background: #fff;
  border: 1rpx solid #ebebeb;
  border-radius: 0;
  box-shadow: 0 8rpx 24rpx 0 rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  display: flex;
  min-height: 184rpx;
  padding: 12rpx;
  position: relative;
}
.sp-order-coupon-detail-modal__card-pic {
  flex-shrink: 0;
  height: 160rpx;
  margin-right: 16rpx;
  width: 160rpx;
}
.sp-order-coupon-detail-modal__card-img {
  border: 1rpx solid #ebebeb;
  border-radius: 8rpx;
  box-sizing: border-box;
  height: 160rpx;
  width: 160rpx;
}
.sp-order-coupon-detail-modal__card-img--placeholder {
  background: #f8f8f8;
}
.sp-order-coupon-detail-modal__card-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
  min-width: 0;
  padding-right: 8rpx;
}
.sp-order-coupon-detail-modal__card-title {
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #1a1a1a;
  display: -webkit-box;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
}
.sp-order-coupon-detail-modal__card-tags {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sp-order-coupon-detail-modal__card-tag {
  align-items: center;
  border-radius: 6rpx;
  box-sizing: border-box;
  display: inline-flex;
  font-size: 18rpx;
  height: 26rpx;
  justify-content: center;
  line-height: 1;
  padding: 0 6rpx;
}
.sp-order-coupon-detail-modal__card-tag--type {
  border: 1rpx solid rgba(212, 0, 59, 0.15);
  color: #d4003b;
}
.sp-order-coupon-detail-modal__card-tag--channel {
  border: 1rpx solid #d6d6d6;
  color: #404040;
}
.sp-order-coupon-detail-modal__card-code {
  align-items: center;
  display: flex;
  gap: 6rpx;
  max-width: 100%;
  min-width: 0;
}
.sp-order-coupon-detail-modal__card-code-label {
  color: #bfbfbf;
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1.4;
}
.sp-order-coupon-detail-modal__card-code-value-wrap {
  align-items: center;
  display: inline-flex;
  gap: 6rpx;
  max-width: 100%;
  min-width: 0;
}
.sp-order-coupon-detail-modal__card-code-value {
  color: #bfbfbf;
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-order-coupon-detail-modal__card-code-icon {
  flex-shrink: 0;
}
.sp-order-coupon-detail-modal__card-action {
  align-items: center;
  align-self: center;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  gap: 4rpx;
  justify-content: center;
  width: 128rpx;
}
.sp-order-coupon-detail-modal__card-action-label {
  color: #d4003b;
  font-size: 24rpx;
  line-height: 1.3;
}
.sp-order-coupon-detail-modal__card-action-amount {
  color: #d4003b;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.3;
}
