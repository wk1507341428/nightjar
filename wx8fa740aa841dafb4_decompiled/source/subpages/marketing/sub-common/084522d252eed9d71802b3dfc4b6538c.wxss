.complete-record .task-img {
  border-radius: 12rpx;
  margin-right: 12rpx;
}
.complete-record-left {
  justify-content: space-between;
}
.complete-record-left,
.complete-record-left-imgtxt {
  align-items: center;
  display: flex;
}
.complete-record-left-txt {
  color: #666;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-style: normal;
  font-weight: 400;
  height: 36rpx;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  text-transform: none;
  white-space: nowrap;
  width: 260rpx;
}
.complete-record .divider {
  border-bottom: 1rpx dotted #ebebeb;
  margin: 36rpx 0;
  text-align: center;
  width: 100%;
}
.complete-record-right {
  display: flex;
  flex-direction: column;
}
.complete-record-right-txt {
  color: #cb9800;
  font-size: 26rpx;
  font-weight: 500;
  height: 36rpx;
}
.complete-record-right-time,
.complete-record-right-txt {
  font-family: PingFang SC;
  font-style: normal;
  text-align: right;
  text-transform: none;
}
.complete-record-right-time {
  color: #bfbfbf;
  font-size: 22rpx;
  font-weight: 400;
  height: 30rpx;
  margin-top: 4rpx;
}
.complete-record .layout-header {
  background-color: #fff;
}
.complete-record .layout {
  border-radius: 24rpx 24rpx 0rpx 0rpx;
}
.complete-record .load-more,
.complete-record .no-more {
  color: #666;
  font-size: 28rpx;
  padding: 20rpx;
  text-align: center;
}
.complete-record .no-more {
  color: #999;
}
.complete-record .layout-header {
  background: #fff;
  text-align: center;
}
.complete-record .at-float-layout__container,
.complete-record .layout-header {
  border-radius: 24rpx 24rpx 0rpx 0rpx;
}
.complete-record .at-float-layout {
  z-index: 999;
}
.complete-record .layout-header__title {
  padding-right: 0rpx;
}
.complete-record .layout-header__btn-close::after,
.complete-record .layout-header__btn-close::before {
  background: #1a1a1a;
}
