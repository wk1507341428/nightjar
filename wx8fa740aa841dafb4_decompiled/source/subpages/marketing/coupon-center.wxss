@import "/subpages/marketing/sub-vendors.wxss";
.page-coupon-center {
  box-sizing: border-box;
}
.page-coupon-center .sticky-wrap .sp-area-select {
  background-color: #fff;
  box-sizing: border-box;
  height: 92rpx;
  justify-content: space-between;
  padding: 0 24rpx;
  width: 100%;
}
.page-coupon-center .sticky-wrap .sp-area-select .items-center {
  justify-content: space-between;
  width: 100%;
}
.page-coupon-center .coupon-item-btns {
  align-items: center;
  background-color: #fff;
  display: flex;
  font-size: 26rpx;
  justify-content: space-around;
  padding-bottom: 18rpx;
  padding-top: 12rpx;
  width: 100%;
}
.page-coupon-center .coupon-item-btns .btn {
  align-items: center;
  display: flex;
  justify-content: center;
  width: 120rpx;
}
.page-coupon-center .coupon-item-btns .btn-active {
  background: rgba(212, 0, 59, 0.1);
  border: 1rpx solid rgba(212, 0, 59, 0.15);
  border-radius: 24rpx;
  color: #d4003b;
  font-weight: 500;
  padding: 10rpx 0rpx;
  width: 126rpx;
}
.page-coupon-center .coupon-item-btns .btn-primary {
  background: #f8f8f8;
  border: 1rpx solid #ebebeb;
  border-radius: 24rpx;
  color: #999;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 400;
  padding: 10rpx 0rpx;
  width: 126rpx;
}
.page-coupon-center .custom-navigation {
  background: linear-gradient(181deg, #fff0c2, #fff 90%);
}
.page-coupon-center .task-list-title {
  color: #000;
  font-family: PingFang SC;
  font-size: 34rpx;
  font-style: normal;
  font-weight: 500;
  margin-left: 130rpx;
  text-align: center;
  text-transform: none;
  width: 100%;
}
.page-coupon-center .sp-page__body {
  display: flex;
  flex-direction: column;
}
.page-coupon-center .sticky-wrap {
  left: 0;
  position: fixed;
  width: 100%;
  z-index: 299;
}
.page-coupon-center .sticky-wrap .region-auth-wrap {
  align-items: center;
  background-color: #fff;
  border-bottom: 1rpx solid #ebebeb;
  color: #1a1a1a;
  display: flex;
  font-size: 32rpx;
  font-weight: 500;
  justify-content: space-between;
  line-height: 38rpx;
  padding: 24rpx 36rpx;
}
.page-coupon-center .sticky-wrap .region-auth-wrap .iconfont {
  font-size: 40rpx;
}
.page-coupon-center .list-scroll {
  box-sizing: border-box;
  height: 100%;
  padding: 280rpx 24rpx 24rpx;
}
.page-coupon-center .list-scroll .coupon-item-wrap:not(:last-child) {
  margin-bottom: 24rpx;
}
.page-coupon-center .list-scroll .coupon-item-wrap .coupon-item-children-wrap {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.page-coupon-center .empty-coupon-text {
  color: #404040;
  font-size: 28rpx;
  padding: 36rpx 0 0;
  text-align: center;
}
.page-coupon-center .empty-coupon-img {
  display: flex;
  justify-content: center;
  padding: 400rpx 0 0;
  text-align: center;
}
.page-coupon-center .empty-wrap {
  color: #999;
  font-size: 24rpx;
  padding: 6rpx 0 0;
  text-align: center;
}
.page-coupon-center .coupon-btn {
  background: var(--color-primary);
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  text-align: center;
}
.page-coupon-center .coupon-btn.btn-get_invalid {
  opacity: 0.15;
}
.page-coupon-center .coupon-btn.btn-disabled {
  background: #d6d6d6;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}
.page-coupon-center .coupon-item-price {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 400;
  margin-top: 6rpx;
  text-align: center;
}
.modal-footer.coupon-modal-footer {
  box-sizing: border-box;
  padding: 0 36rpx 60rpx;
}
.coupon-modal-footer-btn {
  border: 2rpx solid #ebebeb;
  border-radius: 12rpx;
  color: #666;
  flex: 1;
  font-size: 28rpx;
  font-weight: 400;
}
