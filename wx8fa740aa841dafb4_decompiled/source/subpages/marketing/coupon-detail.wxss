@import "/subpages/marketing/sub-vendors.wxss";
.sp-share .sp-float-layout__body {
  z-index: 1002 !important;
}
.sp-share .sp-float-layout-bd {
  padding: 0 !important;
}
.sp-share .share-container {
  height: 314rpx;
}
.sp-share .share-header {
  align-items: center;
  display: flex;
  height: 96rpx;
  justify-content: center;
  position: relative;
}
.sp-share .share-header-txt {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 500;
}
.sp-share .share-header-close {
  height: 40rpx;
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 40rpx;
}
.sp-share .share-bd {
  align-items: flex-start;
  display: flex;
  justify-content: space-evenly;
  padding: 24rpx 0 0;
}
.sp-share .share-bd .share-item {
  align-items: center;
  display: flex;
  flex-direction: column;
  text-align: center;
}
.sp-share .share-bd .share-item:first-child {
  background-color: initial;
  border: none;
  line-height: normal;
  margin: 0;
  overflow: visible;
  padding: 0;
}
.sp-share .share-bd .share-item:first-child:after {
  border: 0rpx;
}
.sp-share .share-bd .share-item-img-wrap {
  align-items: center;
  background: #f8f8f8;
  border-radius: 55rpx;
  display: flex;
  height: 110rpx;
  justify-content: center;
  width: 110rpx;
}
.sp-share .share-bd .share-item-img {
  height: 60rpx;
  width: 60rpx;
}
.sp-share .share-bd .share-item-txt {
  color: #1a1a1a;
  font-size: 24rpx;
  line-height: 28rpx;
  padding-top: 12rpx;
}
.sp-coupon-detail {
  background-color: #f8f8f8;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 176rpx;
  position: relative;
}
.sp-coupon-detail .sp-poster .share-panel__poster {
  top: 35rpx;
}
.sp-coupon-detail .f500 {
  font-weight: 500;
}
.sp-coupon-detail__header {
  background-color: #fff;
  border-bottom: 12rpx solid;
  border-image-outset: 1;
  border-image-repeat: repeat;
  border-image-slice: 12 0;
  border-image-source: url(data:image/png;base64,);
  display: flex;
  justify-content: center;
  padding: 36rpx 36rpx 24rpx;
}
.sp-coupon-detail__header-image {
  height: 160rpx;
  width: 160rpx;
}
.sp-coupon-detail__header-info {
  flex: 1;
  padding-left: 18rpx;
}
.sp-coupon-detail__header-title {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: #1a1a1a;
  display: -webkit-box;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 35rpx;
  margin: 12rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.sp-coupon-detail__header-tags {
  display: flex;
  flex-wrap: wrap;
}
.sp-coupon-detail__header-tag {
  border: 1px solid #d6d6d6;
  border-radius: 6rpx;
  color: #404040;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 21rpx;
  margin-bottom: 8rpx;
  margin-right: 6rpx;
  padding: 0 6rpx;
}
.sp-coupon-detail__header-tag.red {
  border-color: rgba(212, 0, 59, 0.15);
  color: var(--color-primary);
}
.sp-coupon-detail__header-time {
  color: #666;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 23rpx;
}
.sp-coupon-detail__sale-tips {
  background: rgba(203, 152, 0, 0.1);
  border: 1rpx solid rgba(203, 152, 0, 0.15);
  border-radius: 16rpx;
  color: #cb9800;
  font-size: 24rpx;
  font-weight: 500;
  gap: 12rpx;
  height: 88rpx;
  margin: 36rpx 24rpx 0;
  padding: 24rpx 12rpx;
  width: calc(100% - 48rpx);
}
.sp-coupon-detail__code,
.sp-coupon-detail__sale-tips {
  align-items: center;
  box-sizing: border-box;
  display: flex;
}
.sp-coupon-detail__code {
  flex-direction: column;
  padding: 72rpx 0 36rpx;
}
.sp-coupon-detail__code-text1 {
  color: #1a1a1a;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 35rpx;
  margin-bottom: 60rpx;
}
.sp-coupon-detail__code-image {
  width: 338rpx;
}
.sp-coupon-detail__code-text2 {
  color: #1a1a1a;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 28rpx;
  margin: 36rpx 0 60rpx;
}
.sp-coupon-detail__code-text2-disabled {
  opacity: 0.5;
}
.sp-coupon-detail__code-text2-disabled-text {
  text-decoration: line-through;
}
.sp-coupon-detail__code-text3 {
  color: #666;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 30rpx;
  margin-bottom: 12rpx;
}
.sp-coupon-detail__code-text4 {
  align-items: center;
  color: #576b95;
  display: flex;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 30rpx;
}
.sp-coupon-detail__code-text4 .iconfont {
  font-size: 32rpx;
  margin-right: 6rpx;
}
.sp-coupon-detail__card {
  box-sizing: border-box;
  padding: 48rpx 36rpx;
}
.sp-coupon-detail__info-item {
  margin-bottom: 36rpx;
}
.sp-coupon-detail__info-label {
  align-items: center;
  color: #1a1a1a;
  display: flex;
  font-size: 28rpx;
  font-weight: 500;
  justify-content: space-between;
  line-height: 33rpx;
  margin-bottom: 12rpx;
}
.sp-coupon-detail__share {
  align-items: center;
  color: #bfbfbf;
  display: flex;
  flex-direction: column;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 23rpx;
}
.sp-coupon-detail__share .iconfont {
  color: #1a1a1a;
  font-size: 48rpx;
  line-height: 48rpx;
}
.sp-coupon-detail__info-value {
  color: #666;
  font-size: 24rpx;
  line-height: 28rpx;
  padding-top: 6rpx;
  white-space: pre-line;
}
.sp-coupon-detail__info-value.available-product {
  align-items: center;
  display: flex;
  justify-content: space-between;
}
.sp-coupon-detail__instructions {
  margin-top: 12rpx;
}
.sp-coupon-detail__instruction-item {
  display: flex;
  margin-bottom: 12rpx;
}
.sp-coupon-detail__instruction-item:last-child {
  margin-bottom: 0;
}
.sp-coupon-detail__instruction-number {
  color: #333;
  font-size: 28rpx;
  margin-right: 8rpx;
}
.sp-coupon-detail__instruction-text {
  color: #333;
  flex: 1;
  font-size: 28rpx;
  line-height: 1.5;
}
.sp-coupon-detail__stores {
  display: flex;
  flex-wrap: wrap;
}
.sp-coupon-detail__store-item {
  background-color: #fff;
  border-radius: 8rpx;
  color: #1a1a1a;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 30rpx;
  margin-bottom: 12rpx;
  margin-right: 12rpx;
  padding: 16rpx 24rpx;
}
.sp-coupon-detail__available-product {
  align-items: center;
  color: #576b95;
  display: flex;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 28rpx;
}
.sp-coupon-detail__available-product .iconfont {
  font-size: 32rpx;
}
.sp-coupon-detail__footer {
  background-color: #fff;
  bottom: 0;
  box-sizing: border-box;
  left: 0;
  padding: 20rpx 36rpx 80rpx;
  position: fixed;
  right: 0;
}
.sp-coupon-detail__receive-btn {
  background-color: var(--color-primary) !important;
  border: none !important;
  border-radius: 12rpx !important;
  color: #fff !important;
  font-size: 28rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
}
.sp-coupon-detail__receive-btn.disabled {
  opacity: 0.15;
}
.sp-coupon-detail .sp-html {
  color: #666;
  font-size: 24rpx;
}
