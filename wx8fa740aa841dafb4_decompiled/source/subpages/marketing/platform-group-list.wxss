.page-platform-group-list .nav-title {
  color: #000;
  font-family: PingFang SC;
  font-size: 34rpx;
  font-weight: 500;
}
.page-platform-group-list .custom-navigation__right-block {
  width: 64rpx !important;
}
.page-platform-group-list .bg-box {
  background-position: 50%;
  background-repeat: no-repeat;
  background-size: cover;
  display: flex;
  flex-direction: column;
  height: 292rpx;
  justify-content: flex-end;
  position: relative;
}
.page-platform-group-list .bg-box__hd {
  display: flex;
  justify-content: flex-end;
  padding: 0 12rpx 66rpx;
}
.page-platform-group-list .bg-box__hd .limited-rule {
  align-items: center;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 22rpx;
  display: flex;
  height: 44rpx;
  justify-content: center;
  padding-left: 6rpx;
  padding-right: 18rpx;
}
.page-platform-group-list .bg-box__hd .limited-rule .iconfont {
  color: #fff;
  font-size: 28rpx;
}
.page-platform-group-list .bg-box__hd .limited-rule__text {
  color: #fff;
  font-family: PingFang SC;
  font-size: 22rpx;
  font-weight: 500;
  height: 32rpx;
  padding-left: 2rpx;
}
.page-platform-group-list__scrollview-bg {
  background-color: #fff;
  border-radius: 24rpx 24rpx 0rpx 0rpx;
  height: 36rpx;
  margin-top: -36rpx;
  position: absolute;
  width: 100%;
  z-index: 11;
}
.page-platform-group-list .sp-fv-scrollview {
  background: #fff;
}
.page-platform-group-list__main {
  background: #fff;
  padding: 0 24rpx;
}
.page-platform-group-list__item {
  padding-bottom: 24rpx;
}
.page-platform-group-list .rule-modal-box {
  padding: 60rpx 48rpx;
}
.page-platform-group-list .rule-modal__header {
  color: #1a1a1a;
  font-family: PingFang SC;
  font-size: 34rpx;
  font-weight: 500;
  padding-bottom: 18rpx;
  text-align: center;
}
.page-platform-group-list .rule-modal__scroll {
  max-height: 520rpx;
}
.page-platform-group-list .rule-modal__content {
  color: #666;
  font-family: PingFang SC;
  font-size: 30rpx;
  font-weight: 400;
  white-space: pre-wrap;
}
.page-platform-group-list .rule-modal__footer {
  align-items: center;
  display: flex;
  justify-content: center;
  padding-top: 48rpx;
}
.page-platform-group-list .rule-modal__footer .confirm-btn {
  align-items: center;
  background: #ff0047;
  border-radius: 12rpx;
  color: #fff;
  display: flex;
  font-family: PingFang SC;
  font-size: 28rpx;
  font-weight: 500;
  height: 88rpx;
  justify-content: center;
  width: 344rpx;
}
.page-platform-group-list .no-limited {
  align-items: center;
  display: flex;
  flex-direction: column;
  height: 312rpx;
  justify-content: center;
  padding-top: 224rpx;
  width: 750rpx;
}
.page-platform-group-list .no-limited__icon .iconfont {
  color: #d6d6d6;
  font-size: 64rpx;
}
.page-platform-group-list .no-limited__text {
  color: #404040;
  font-family: PingFang SC;
  font-size: 28rpx;
  font-weight: 400;
  margin-top: 24rpx;
}
