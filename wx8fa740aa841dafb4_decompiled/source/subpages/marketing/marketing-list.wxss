.page-marketing-list .marketing-info {
  background-color: #fff;
  padding: 48rpx 36rpx 24rpx;
}
.page-marketing-list .marketing-info__title {
  color: var(--color-primary);
  font-family: PingFang SC;
  font-size: 42rpx;
  font-weight: 500;
  height: 58rpx;
}
.page-marketing-list .marketing-info__time {
  height: 34rpx;
  padding-bottom: 12rpx;
  padding-top: 24rpx;
}
.page-marketing-list .marketing-info__desc,
.page-marketing-list .marketing-info__time {
  color: #bfbfbf;
  font-family: PingFang SC;
  font-size: 24rpx;
  font-weight: 400;
}
.page-marketing-list .marketing-info .goods-info {
  border: 1px solid #ebebeb;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  padding: 12rpx;
}
.page-marketing-list .marketing-info .goods-info__item {
  padding-top: 24rpx;
}
.page-marketing-list .marketing-info .goods-info__img {
  position: relative;
}
.page-marketing-list .marketing-info .goods-info__img .sp-image {
  border-radius: 8rpx;
  height: 164rpx;
  width: 164rpx;
}
.page-marketing-list .marketing-info .goods-info__img .soldout-mask {
  align-items: center;
  background: hsla(0, 0%, 100%, 0.5);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 99;
}
.page-marketing-list
  .marketing-info
  .goods-info__img
  .soldout-mask
  .soldout-mask-text {
  align-items: center;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  height: 138rpx;
  justify-content: center;
  width: 138rpx;
}
.page-marketing-list
  .marketing-info
  .goods-info__img
  .soldout-mask
  .soldout-mask-text
  text {
  color: #fff;
  font-size: 26rpx;
}
.page-marketing-list .marketing-info .goods-info__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  height: 164rpx;
  justify-content: space-between;
  padding-left: 18rpx;
}
.page-marketing-list .marketing-info .goods-info__title {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: #1a1a1a;
  display: -webkit-box;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.page-marketing-list .marketing-info .goods-info__desc {
  color: #bfbfbf;
  font-family: PingFang SC;
  font-size: 24rpx;
  font-weight: 400;
}
.page-marketing-list .marketing-info .goods-info__num {
  color: #666;
  font-family: PingFang SC;
  font-size: 24rpx;
  font-weight: 400;
}
.page-marketing-list .marketing-info .goods-info__price {
  color: #1a1a1a;
  font-family: D-DIN-PRO-Medium;
  font-size: 34rpx;
  font-weight: 500;
}
.page-marketing-list .marketing-info .goods-info__tag {
  color: var(--color-primary);
  font-family: PingFang SC;
  font-size: 22rpx;
  font-weight: 400;
}
.page-marketing-list .filter-container {
  position: sticky;
  top: 0;
  z-index: 100;
}
.page-marketing-list .result-empty-text {
  color: #bfbfbf;
  font-size: 28rpx;
  font-weight: 400;
  padding: 108rpx 0 48rpx;
  text-align: center;
}
.page-marketing-list .search-list__container.result-empty .sp-filter-line {
  visibility: hidden;
}
.page-marketing-list .waterfall-container {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(2, 1fr);
}
.page-marketing-list .waterfall-container .waterfall-left__container,
.page-marketing-list .waterfall-container .waterfall-right__container {
  overflow: hidden;
  width: 100%;
}
.marketing-list-footer-btn {
  align-items: center;
  background: #d4003b;
  border-radius: 12rpx;
  color: #fff;
  display: flex;
  font-family: PingFang SC;
  font-size: 28rpx;
  font-style: normal;
  font-weight: 500;
  height: 88rpx;
  justify-content: center;
  text-align: center;
  text-transform: none;
  width: 344rpx;
}
