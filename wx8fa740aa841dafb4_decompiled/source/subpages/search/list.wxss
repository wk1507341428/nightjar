.sp-component-newprice {
  color: #f4811f;
  display: inline-block;
  font-size: 24rpx;
  line-height: 1;
  position: relative;
}
.sp-component-newprice.discount {
  color: #bbb;
}
.sp-component-newprice.discount:after {
  background-color: #bbb;
  content: "";
  display: block;
  height: 1rpx;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
}
.sp-component-newprice .int {
  font-size: 32rpx;
  font-weight: 500;
}
.sp-component-newprice.equal .int {
  font-size: inherit;
  font-weight: inherit;
}
.sp-component-newprice.small {
  font-size: 20rpx;
}
.sp-trade-item {
  display: flex;
  margin-bottom: 24rpx;
}
.sp-trade-item .tradeitem-hd {
  border-radius: 8rpx;
  margin-right: 18rpx;
  overflow: hidden;
}
.sp-trade-item .tradeitem-hd-img {
  background: #d9d9d9;
  border-radius: 8rpx;
  height: 164rpx;
  width: 164rpx;
}
.sp-trade-item .tradeitem-bd {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}
.sp-trade-item .tradeitem-bd .buy-count {
  display: flex;
  justify-content: flex-end;
}
.sp-trade-item .goods-info-hd {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.sp-trade-item .goods-info-hd .name {
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  color: #1a1a1a;
  display: -webkit-box;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.sp-trade-item .goods-info-hd .name .prescription-drug {
  border: 1px solid var(--color-primary);
  border-radius: 4rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 34rpx;
  margin-right: 8rpx;
  padding: 0 4rpx;
}
.sp-trade-item .goods-info-hd .desc {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  color: #bfbfbf;
  display: -webkit-box;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 28rpx;
  overflow: hidden;
  padding-top: 8rpx;
  text-overflow: ellipsis;
  word-break: break-all;
}
.sp-trade-item .price {
  color: #1a1a1a;
  font-family: D-DIN-PRO-Medium;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 34rpx;
  width: 100%;
}
.sp-trade-item .trade-item-price-row {
  align-items: flex-end;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
  min-width: 0;
  width: 100%;
}
.sp-trade-item .trade-item-price {
  flex-shrink: 0;
  line-height: 40rpx;
}
.sp-trade-item .trade-item-discount {
  align-items: center;
  display: flex;
  flex-shrink: 0;
  gap: 4rpx;
}
.sp-trade-item .trade-item-discount-label {
  color: #d4003b;
  font-family: PingFang SC;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
}
.sp-trade-item .trade-item-discount-arrow {
  color: #d4003b;
  font-size: 22rpx;
  line-height: 1;
}
.sp-trade-item .goods-info-bd {
  display: flex;
  justify-content: space-between;
}
.sp-trade-item .goods-info-bd .num,
.sp-trade-item .goods-info-bd .spec-desc {
  color: #999;
  font-size: 24rpx;
  margin-top: 10rpx;
}
.sp-trade-item .goods-info-bd .spec-desc {
  max-width: 440rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-trade-item .after-sale-info {
  justify-content: space-between;
}
.sp-trade-item .goods-info-return-money {
  align-items: center;
