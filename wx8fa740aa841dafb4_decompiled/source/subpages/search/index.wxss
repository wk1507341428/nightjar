.sp-search-page {
  background: #f8f8f8;
  display: flex;
  flex-direction: column;
  height: auto;
  min-height: 100vh;
}
.sp-search-page__content {
  height: 100%;
}
.sp-search-page__content-bottom {
  height: env(safe-area-inset-bottom);
}
.sp-search-page__section:first-child {
  padding-top: 36rpx;
}
.sp-search-page__section-header {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  padding: 0 36rpx 24rpx;
}
.sp-search-page__section--history,
.sp-search-page__section--hot {
  padding-bottom: 60rpx;
}
.sp-search-page__section-title {
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 500;
}
.sp-search-page__section-action {
  color: #999;
}
.sp-search-page__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  overflow: hidden;
  padding: 0 24rpx;
}
.sp-search-page__tag {
  border: 1px solid #d6d6d6;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #999;
  font-size: 26rpx;
  height: 60rpx;
  overflow: hidden;
  padding: 12rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-search-page__tag--loading {
  opacity: 0;
}
.sp-search-page__tag_icon {
  height: 40rpx;
  width: 40rpx;
}
.sp-search-page__hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  max-height: 154rpx;
  overflow: hidden;
  padding: 0 24rpx;
}
.sp-search-page__hot-tag {
  align-items: center;
  background: #fff;
  border: 1px solid #ebebeb;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #1a1a1a;
  display: flex;
  font-size: 26rpx;
  height: 68rpx;
  padding: 16rpx 24rpx;
}
.sp-search-page__hot-tag--highlight {
  color: #ff6b00;
}
.sp-search-page__hot-icon {
  color: #ff6b00;
  margin-right: 4rpx;
}
.sp-search-page__ranking {
  box-sizing: border-box;
  display: flex;
  margin-left: 24rpx;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}
.sp-search-page__ranking-section {
  border-radius: 24rpx;
  border-right: 1px solid #fff;
  flex: 1;
  height: -moz-fit-content;
  height: fit-content;
  margin-right: 24rpx;
  min-width: 462rpx;
  padding: 12rpx;
  scroll-snap-align: start;
  width: 462rpx;
}
.sp-search-page__ranking-title {
  align-items: center;
  color: #fff9e1;
  display: flex;
  font-family: PingFang SC;
  font-size: 30rpx;
  font-style: normal;
  font-weight: 500;
  height: 42rpx;
  justify-content: space-between;
  line-height: 42rpx;
  padding: 12rpx 24rpx 12rpx 12rpx;
  text-align: left;
  text-transform: none;
}
.sp-search-page__ranking-title .iconfont {
  color: #fff9e1;
  font-size: 32rpx;
}
.sp-search-page__ranking-list {
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 6rpx;
}
.sp-search-page__ranking-item {
  align-items: center;
  display: flex;
}
.sp-search-page__ranking-item:not(:last-child) {
  margin-bottom: 12rpx;
}
.sp-search-page__ranking-item:nth-child(1) .sp-search-page__ranking-item-left {
  border: 1px solid rgba(203, 152, 0, 0.25);
}
.sp-search-page__ranking-item:nth-child(1) .sp-search-page__ranking-index {
  background: linear-gradient(180deg, #ffebae, #f0c33b 17%, #654b00);
  text-shadow: 0rpx 1rpx 0rpx #6b5001;
}
.sp-search-page__ranking-item:nth-child(2) .sp-search-page__ranking-item-left {
  border: 1px solid rgba(87, 107, 149, 0.25);
}
.sp-search-page__ranking-item:nth-child(2) .sp-search-page__ranking-index {
  background: linear-gradient(180deg, #dbe7ff, #97a9ce 17%, #1b222f);
  text-shadow: 0rpx 1rpx 0rpx #1e2533;
}
.sp-search-page__ranking-item:nth-child(3) .sp-search-page__ranking-item-left {
  border: 1px solid rgba(222, 127, 72, 0.25);
}
.sp-search-page__ranking-item:nth-child(3) .sp-search-page__ranking-index {
  background: linear-gradient(180deg, #ffe2d1, #dc9064 17%, #784427);
  text-shadow: 0rpx 1rpx 0rpx #7e4829;
}
.sp-search-page__ranking-item-left {
  background: rgba(0, 0, 0, 0.1);
  background: #f8f8f8;
  border: 1px solid rgba(87, 107, 149, 0.25);
  border-radius: 12rpx;
  height: 96rpx;
  overflow: hidden;
  position: relative;
  width: 96rpx;
}
.sp-search-page__ranking-index {
  align-items: center;
  background: linear-gradient(180deg, #e3e3e3, #bababa 16%, #444);
  border-radius: 12rpx 0rpx 12rpx 0rpx;
  color: #fff;
  display: flex;
  font-family: D-DIN-PRO;
  font-size: 18rpx;
  font-weight: 800;
  height: 24rpx;
  justify-content: center;
  left: 0;
  padding: 0 6rpx;
  position: absolute;
  text-shadow: 0rpx 1rpx 0rpx #363636;
  top: 0;
  width: -moz-fit-content;
  width: fit-content;
  z-index: 9;
}
.sp-search-page__ranking-content {
  box-sizing: border-box;
  flex: 1;
  overflow: hidden;
  padding: 12rpx 0rpx 12rpx 12rpx;
}
.sp-search-page__ranking-item-title {
  color: #1a1a1a;
  font-family: PingFang SC;
  font-size: 26rpx;
  font-weight: 500;
  height: 36rpx;
  line-height: 36rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sp-search-page__ranking-item-info {
  align-items: center;
  display: flex;
  justify-content: space-between;
}
.sp-search-page__ranking-item-info-hot {
  align-items: center;
  color: #ff9500;
  display: flex;
  font-family: D-DIN-PRO;
  font-size: 24rpx;
  font-weight: 500;
  padding-right: 18rpx;
}
.sp-search-page__list {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 36rpx;
}
.sp-search-page__item {
  align-items: center;
  color: #666;
  display: flex;
  font-family: PingFang SC-Medium;
  font-size: 32rpx;
  font-weight: 400;
  height: 80rpx;
  justify-content: flex-start;
}
.sp-search-page__item_icon {
  height: 40rpx;
  margin-right: 12rpx;
  width: 40rpx;
}
.sp-search-page__highlight {
  color: #1a1a1a;
  font-family: PingFang SC-Regular;
  font-size: 32rpx;
  font-weight: 500;
}
