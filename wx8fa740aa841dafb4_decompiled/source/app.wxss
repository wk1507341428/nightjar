.at-button--secondary {
  background: #c1c1c1;
  border: 1px solid #c1c1c1;
  color: #fff;
}
.at-button--small {
  font-size: 22rpx;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 22rpx;
}
