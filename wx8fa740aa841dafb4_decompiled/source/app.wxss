.list .list-item {
  align-items: center;
  display: flex;
  padding: 25rpx;
  position: relative;
}
.list .list-item.no-flex {
  display: block;
}
.list .list-item::after {
  background: #f8f8f8;
  bottom: -1rpx;
  content: " ";
  height: 1rpx;
  left: 30rpx;
  position: absolute;
  right: 0;
}
.list .list-item:last-child::after {
  height: 0;
}
.list .list-item.icon-align-top {
  align-items: top;
}
.list .list-item .item-icon {
  color: #999;
  font-size: 45rpx;
}
.list .list-item .list-item-txt {
  color: #333;
  flex: 1;
  font-size: 28rpx;
  padding: 0 16rpx 0 0;
}
.list .list-item .label {
  color: #999;
  font-size: 28rpx;
  width: 150rpx;
}
.list .list-item .item-icon + .label,
.list .list-item .item-icon + .list-item-txt {
  padding: 0 16rpx;
}
.list .list-item .list-txt {
  color: #333;
  font-size: 28rpx;
  padding: 0 16rpx;
}
.list .list-item .item-icon-go {
  color: #ccc;
  font-size: 32rpx;
}
.grid {
