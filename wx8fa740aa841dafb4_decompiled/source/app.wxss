  padding-bottom: 17rpx;
}
.at-rate {
  font-size: 0;
  line-height: 0;
}
.at-rate__left {
  color: transparent;
  display: inline-block;
  height: 100%;
  left: 0;
  overflow: hidden;
  position: absolute;
  top: 0;
  width: 50%;
  z-index: 10;
}
.at-rate__icon {
  color: #ececec;
  display: inline-block;
  font-size: 0;
  line-height: 0;
  position: relative;
  transition: all 0.2s;
}
.at-rate__icon .at-icon {
  font-size: 20px;
}
.at-rate__icon--on {
  color: #ffca3e;
}
.at-rate__icon--off {
  color: #ececec;
}
.at-rate__icon--half .at-rate__left {
  color: #ffca3e;
}
.at-switch {
  align-items: center;
  background-color: #fff;
  display: flex;
  justify-content: center;
  margin-bottom: 1px;
  margin-left: 32rpx;
  padding: 24rpx 32rpx 24rpx 0;
  position: relative;
}
.at-switch::after {
  border: solid #d6e4ef;
  border-width: 0 0 1px;
  bottom: -50%;
  box-sizing: border-box;
  content: "";
  left: -50%;
  pointer-events: none;
  position: absolute;
  right: -50%;
  top: -50%;
  transform: scale(0.5);
  transform-origin: center;
}
.at-switch__title {
  color: #1a1a1a;
  flex: 6;
  font-size: 28rpx;
}
.at-switch__container {
  align-items: center;
  background-color: #fff;
  display: flex;
  flex: 2;
  flex-direction: row-reverse;
  position: relative;
}
.at-switch__switch {
  display: inline-block;
}
.at-switch__mask {
  bottom: 0;
  display: none;
  left: 0;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 700;
}
.at-switch--disabled .at-switch__switch {
  opacity: 0.3;
}
.at-switch--disabled .at-switch__mask {
  display: block;
}
.at-switch--without-border::after {
  border: none;
}
@keyframes loading {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(1turn);
  }
}
.at-loading {
  display: inline-block;
  height: 36rpx;
  position: relative;
  width: 36rpx;
}
.at-loading__ring {
  animation: loading 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  border: 1px solid transparent;
  border-radius: 50%;
  border-top-color: #ff593d;
  box-sizing: border-box;
  display: block;
  height: 36rpx;
  margin: 1px;
  position: absolute;
  width: 36rpx;
}
.at-loading__ring:nth-child(1) {
  animation-delay: -0.45s;
}
.at-loading__ring:nth-child(2) {
  animation-delay: -0.3s;
}
.at-loading__ring:nth-child(3) {
  animation-delay: -0.15s;
}
.at-modal__overlay {
  background-color: rgba(0, 0, 0, 0.8);
}
.at-modal__container {
  width: 86%;
}
.at-modal__header:after {
  border: none !important;
}
.at-form {
  background-color: initial;
  padding-left: 0;
}
.at-form:after {
  border: none !important;
}
.at-input {
  margin: 0 0 30rpx;
  padding: 24rpx 0;
}
.at-input__title {
  font-size: 28rpx;
}
.at-input:after {
  border-width: 0;
}
.at-input input {
  font-size: 28rpx;
}
.at-input__children::after {
  border: none;
}
.at-drawer {
  z-index: 1000;
}
.isHidden.searchInput .at-input {
  width: 300rpx;
}
.searchInput .at-input {
  background: #fff !important;
  border: 1px solid #ddd !important;
  border-radius: 30rpx !important;
  height: 60rpx !important;
  margin: 0 !important;
  padding: 0 0 0 15rpx;
  width: 140rpx;
}
.searchInput .at-input__container {
  height: 100%;
}
.searchInput .at-input::after {
  border-color: transparent !important;
}
.active .search-icon {
  display: none;
}
.active .at-input {
  width: 716rpx !important;
}
.searchInput-P .at-input {
  transition: width 0.3s;
}
.at-nav-bar__title {
  font-size: 33rpx;
}
.at-nav-bar__item--active {
  color: #ff593d;
}
.at-tab-bar {
  align-items: center;
  padding: 0;
}
.at-tab-bar__item {
  line-height: 1;
  padding: 0 12rpx;
}
.at-tab-bar .at-tab-bar__icon .icon,
.at-tab-bar .at-tab-bar__icon .iconfont {
  font-size: 42rpx;
}
.at-search-bar {
  height: 60rpx;
  padding: 0;
}
.at-search-bar__input-cnt {
  background-color: #f5f5f5;
}
.at-search-bar__placeholder-wrap {
  justify-content: flex-start;
}
.at-search-bar__action {
  background-color: initial;
  color: #333;
}
.at-search-bar .at-icon-search {
  color: var(--color-primary);
}
.at-search-bar:after {
  border-color: transparent;
}
.taro__toast,
.taro__toast p {
  font-size: 28rpx !important;
}
.at-tab-bar {
  box-shadow: -20rpx 5rpx 15rpx rgba(0, 0, 0, 0.1);
