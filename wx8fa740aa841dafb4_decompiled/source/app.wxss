.grid-item .view-img-wrap {
  background: #fff;
  position: relative;
  width: 100%;
}
.grid-item .view-img-wrap::after {
  content: " ";
  display: block;
  padding-top: 100%;
}
.grid-item .view-img-wrap .view-cover,
.grid-item .view-img-wrap .view-img {
  height: 100%;
  position: absolute;
  width: 100%;
}
.tabs {
  background: #fff;
  box-shadow: 0 0 5rpx rgba(0, 0, 0, 0.3);
  height: 100rpx;
  left: 0;
  overflow: hidden;
  position: fixed;
  right: 0;
  top: 0;
  white-space: nowrap;
  z-index: 99;
}
.tabs .tabs-item {
  align-items: center;
  color: #999;
  display: flex;
  font-size: 28rpx;
  height: 90rpx;
  justify-content: center;
  transition: all 0.2s ease;
}
.tabs .tabs-item.active {
  color: #ff5000;
  font-size: 32rpx;
  font-weight: 500;
}
.tabs .tabbar {
  bottom: 15rpx;
  height: 8rpx;
  left: 0;
  position: absolute;
  transition: all 0.2s ease;
}
.tabs .tabbar::after {
  background: #ff5000;
  border-radius: 24rpx;
  content: "";
  height: 8rpx;
  left: 50%;
  position: absolute;
  transform: translateX(-50%);
  width: 40%;
  z-index: 5;
}
.tab-content {
  padding-top: 110rpx !important;
}
.input {
