.sp-area-select-text {
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}
.sp-area-select {
  min-width: 0;
  overflow: hidden;
  position: relative;
  z-index: 303;
}
.sp-area-select__inner {
  align-items: center;
  display: inline-flex;
  height: 32rpx;
  max-width: 100%;
  padding-right: 36rpx;
  position: relative;
}
.sp-area-select__head,
.sp-area-select__rest {
  display: inline;
  line-height: 32rpx;
}
.sp-area-select .area-select-down-icon {
  align-items: center;
  bottom: 0;
  display: flex;
  height: 32rpx;
  justify-content: center;
  left: calc(100% - 32rpx);
  line-height: 32rpx !important;
  margin: auto 0;
  position: absolute;
  top: 0;
  transform: translateY(2rpx);
  transition: left 0.4s ease-out;
  width: 32rpx;
  z-index: 2;
}
.sp-area-select--fade-tail {
  overflow: visible;
  z-index: 1;
}
.sp-area-select--fade-tail .sp-area-select__inner {
  overflow: visible;
}
.sp-area-select--fade-tail .area-select-down-icon {
  left: 64rpx;
}
.sp-area-select--fade-tail .sp-area-select__rest {
  opacity: 0;
  transition: opacity 0.4s ease-out;
}
.sp-area-select:not(.sp-area-select--fade-tail) .sp-area-select__rest {
  opacity: 1;
  transition: opacity 0.4s ease-out;
}
.sp-area-select--fade-instant .area-select-down-icon,
.sp-area-select--fade-instant .sp-area-select__rest {
  transition: none !important;
}
