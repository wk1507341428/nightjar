body,
view {
  font-family: PingFangSC-Regular, PingFang SC, 微软雅黑, Microsoft YaHei,
    Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}
body,
page {
  background: #f8f8f8;
  color: #1a1a1a;
}
body {
  overflow: hidden;
  position: inherit !important;
}
.taro__modal {
  transition: opacity 0s linear 0s !important;
}
::-webkit-scrollbar {
  display: none;
}
#react-refresh-overlay {
  display: none;
}
.lnk {
  color: #d42f29;
}
.lock-screen {
  height: 100%;
  overflow: hidden;
  position: fixed;
  width: 100%;
}
.hidden {
  display: none !important;
}
.sec {
  background: #fff;
  margin: 0 0 16rpx;
}
.sec-hd {
  align-items: center;
  display: flex;
  line-height: 1;
  padding: 30rpx;
}
.sec-hd .more {
  color: #d42f29;
  font-size: 25rpx;
  margin-right: 7rpx;
}
.sec-hd .at-icon {
  font-size: 33rpx;
}
.sec-title {
  flex: 1;
}
.sec-ft {
  color: #aaa;
  margin-right: -8rpx;
}
.sec-ft .at-font {
  font-size: 33rpx;
}
.btns {
  padding: 16rpx 30rpx;
}
.btns .at-button,
.btns button {
  margin: 0 0 16rpx;
}
.page-trade-refund .at-tabs__page {
  display: none;
}
.toolbar {
  align-content: center;
  align-items: center;
  background: #fff;
  bottom: 0;
  box-shadow: 0-2rpx 3rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  display: flex;
  font-size: 28rpx;
  height: 100rpx;
  justify-content: space-between;
  left: 0;
  padding: 16rpx 30rpx;
  position: fixed;
  z-index: 100;
}
.toolbar,
.toolbar.toolbar-inline .at-button,
.toolbar.toolbar-inline at-button {
  width: 100%;
}
.toolbar .at-button {
  font-size: 28rpx;
}
.toolbar-ft {
  max-width: 120rpx;
}
.search-input__bar .at-search-bar__input {
  line-height: 20rpx;
}
.AtFlayout .layout,
.AtFlayout .layout-body {
  border-radius: 15rpx 15rpx 0 0;
}
.AtFlayout .layout-body {
  background: #efefef;
  padding: 0;
}
.usericon {
  border: 4rpx solid #fff;
  border-radius: 50rpx;
  height: 110rpx;
  margin-right: 30rpx;
  width: 110rpx;
}
.weui-input {
  height: 100%;
}
.wgt.wgt__padded {
  padding: 20rpx 0rpx;
}
.wgt .wgt-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0rpx 16rpx;
}
.wgt .wgt-head .wgt-hd {
  align-items: baseline;
  display: flex;
  flex: 1;
}
.wgt .wgt-head .wgt-hd .wgt-title {
  color: #222;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 16rpx;
  max-width: 30%;
}
.wgt .wgt-head .wgt-hd .wgt-title,
.wgt .wgt-head .wgt-subtitle {
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}
.wgt .wgt-head .wgt-subtitle {
  color: #999;
  font-size: 28rpx;
  max-width: 55%;
}
.wgt .wgt-head .wgt-more {
  align-items: center;
  border-radius: 60rpx;
  display: flex;
  height: 24rpx;
  justify-content: center;
  width: 60rpx;
}
.wgt .wgt-head .wgt-more .three-dot {
  background: #333;
  border-radius: 50%;
  height: 8rpx;
  position: relative;
  width: 8rpx;
}
.wgt .wgt-head .wgt-more .three-dot::after,
.wgt .wgt-head .wgt-more .three-dot::before {
  background: #333;
  border-radius: 50%;
  content: "";
  height: 8rpx;
  position: absolute;
  width: 8rpx;
}
.wgt .wgt-head .wgt-more .three-dot::before {
