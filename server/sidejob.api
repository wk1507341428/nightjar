syntax = "v1"

info (
	title: "SideJob API"
	desc: "SideJob 本地服务"
	author: "SideJob"
)

type HealthResponse {
	Status string `json:"status"`
}

type MarketplaceListingResponse {
	Id             string `json:"id"`
	Platform       string `json:"platform"`
	PlatformItemId string `json:"platformItemId"`
	SourceItemId   string `json:"sourceItemId,optional"`
	ItemNo         string `json:"itemNo,optional"`
	Title          string `json:"title"`
	PriceCents     int64  `json:"priceCents"`
	ImageUrl       string `json:"imageUrl,optional"`
	ItemUrl        string `json:"itemUrl,optional"`
	ListedAt       string `json:"listedAt"`
	LastSyncedAt   string `json:"lastSyncedAt"`
}

type MarketplaceListingListResponse {
	List         []MarketplaceListingResponse `json:"list"`
	Total        int                          `json:"total"`
	LastSyncedAt string                       `json:"lastSyncedAt,optional"`
}

type MarketplaceSyncResponse {
	Platform     string `json:"platform"`
	SyncedCount  int    `json:"syncedCount"`
	LastSyncedAt string `json:"lastSyncedAt"`
}

type SeckillActivity {
	Id        string `json:"id"`
	Name      string `json:"name"`
	Status    string `json:"status"`
	StartTime int64  `json:"startTime"`
	EndTime   int64  `json:"endTime"`
	RegionId  string `json:"regionId"`
}

type SeckillProductsResponse {
	RegionId   string             `json:"regionId"`
	Activities []SeckillActivity `json:"activities"`
	List       []map[string]any  `json:"list"`
	Total      int64              `json:"total"`
}

type ConnectionResponse {
	Platform       string `json:"platform"`
	Status         string `json:"status"`
	Authenticated  bool   `json:"authenticated"`
	LastVerifiedAt string `json:"lastVerifiedAt,optional"`
	Message        string `json:"message,optional"`
}

type SaveXianyuSessionRequest {
	Cookie string `json:"cookie"`
}

type CreatePublishTaskRequest {
	SourceItemId      string   `json:"sourceItemId"`
	ItemNo            string   `json:"itemNo"`
	Title             string   `json:"title"`
	Description       string   `json:"description"`
	PriceCents        int64    `json:"priceCents"`
	OriginalPriceCents int64   `json:"originalPriceCents,optional"`
	ImageURLs         []string `json:"imageUrls"`
	RegionId          string   `json:"regionId,optional"`
	Brand             string   `json:"brand,optional"`
	Condition         string   `json:"condition"`
	AvailableSizes    []string `json:"availableSizes,optional"`
	IsFootwear        bool     `json:"isFootwear"`
}

type PublishTaskResponse {
	Id         string `json:"id"`
	Status     string `json:"status"`
	ItemNo     string `json:"itemNo"`
	Title      string `json:"title"`
	PriceCents int64  `json:"priceCents"`
	XianyuItemId string `json:"xianyuItemId,optional"`
	XianyuURL  string `json:"xianyuUrl,optional"`
	ErrorMessage string `json:"errorMessage,optional"`
	CreatedAt  string `json:"createdAt"`
	UpdatedAt  string `json:"updatedAt"`
}

type PublishTaskListResponse {
	List []PublishTaskResponse `json:"list"`
}

@server (
	prefix: /api
)
service sidejob-api {
	@handler health
	get /healthz returns (HealthResponse)

	@handler listSeckillProducts
	get /catalog/seckill returns (SeckillProductsResponse)

	@handler listMarketplaceListings
	get /marketplace/listings returns (MarketplaceListingListResponse)

	@handler syncMarketplaceListings
	post /marketplace/sync returns (MarketplaceSyncResponse)

	@handler saveXianyuSession
	post /xianyu/session (SaveXianyuSessionRequest) returns (ConnectionResponse)

	@handler getXianyuConnection
	get /xianyu/connection returns (ConnectionResponse)

	@handler deleteXianyuSession
	delete /xianyu/session returns (ConnectionResponse)

	@handler createPublishTask
	post /xianyu/publish-tasks (CreatePublishTaskRequest) returns (PublishTaskResponse)

	@handler getPublishTask
	get /xianyu/publish-tasks/:id returns (PublishTaskResponse)

	@handler retryPublishTask
	post /xianyu/publish-tasks/:id/retry returns (PublishTaskResponse)

	@handler listPublishTasks
	get /xianyu/publish-tasks returns (PublishTaskListResponse)
}
